{
  "name": "packwise-sih26236",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PackWise web dashboard (React + TypeScript) — SIH Problem Statement 26236. Backend: Python + FastAPI in /backend; mobile: Flutter in /mobile.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && python -m uvicorn app.main:app --reload --port 8787",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run",
    "test:api": "cd backend && python -m pytest -q",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:images": "node -e \"require('fs').cpSync('reference-data/images','public/images',{recursive:true})\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
