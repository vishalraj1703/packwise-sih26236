# PackWise configuration (copy to .env or set in your shell)

# Optional: enables photo identification, report extraction and the online explainer.
# Without it, the app uses manual selection/entry and the offline assistant.
ANTHROPIC_API_KEY=
# PACKWISE_MODEL=claude-opus-5-5

# Password for the seeded demo accounts (local demonstration only):
#   producer@demo.packwise, transporter@demo.packwise, retailer@demo.packwise,
#   expert@demo.packwise, admin@demo.packwise
PACKWISE_DEMO_PASSWORD=packwise-demo

# Base URL encoded in batch QR codes (defaults to the request host)
# PUBLIC_BASE_URL=http://192.168.1.10:8787
# API_PORT=8787 (dev); in production PORT is honoured
